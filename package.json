{
  "name": "frontend_temp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run backend\" \"npm run tts\" \"npm run odl-hybrid\"",
    "backend": "cd backend && npm run dev",
    "tts": "uvx --python 3.11 pocket-tts serve --port 8000",
    "odl-hybrid": "uvx --python 3.11 --with \"opendataloader-pdf[hybrid]\" opendataloader-pdf-hybrid --port 5002 --enrich-formula --enrich-picture-description --force-ocr",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.2",
    "framer-motion": "^13.0.0",
    "imagekitio-react": "^4.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^20.1.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
